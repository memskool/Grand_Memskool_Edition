rules_version = '2';

// Storage paths:
// avatars/{uid}/*
// users/{uid}/locker/{allPaths=**}
// schools/{schoolId}/assignments/{allPaths=**}
// schools/{schoolId}/submissions/{allPaths=**}
// schools/{schoolId}/lessons/{allPaths=**}
// schools/{schoolId}/resources/{allPaths=**}
// recordings/{schoolId}/{allPaths=**}

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }
    function uid() {
      return request.auth.uid;
    }
    function role() {
      return request.auth.token.role;
    }
    function school() {
      return request.auth.token.schoolId;
    }
    function isSchoolStaff() {
      return role() in ['teacher', 'admin', 'institution', 'superadmin'];
    }
    function sameSchool(schoolId) {
      return school() == schoolId;
    }
    function under50mb() {
      return request.resource.size < 50 * 1024 * 1024;
    }
    function under5mb() {
      return request.resource.size < 5 * 1024 * 1024;
    }
    function under80mb() {
      return request.resource.size < 80 * 1024 * 1024;
    }
    function under200mb() {
      return request.resource.size < 200 * 1024 * 1024;
    }
    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }
    function isEducationFile() {
      return request.resource.contentType.matches('image/.*')
        || request.resource.contentType.matches('video/.*')
        || request.resource.contentType.matches('audio/.*')
        || request.resource.contentType == 'application/pdf'
        || request.resource.contentType == 'text/plain'
        || request.resource.contentType == 'application/zip'
        || request.resource.contentType == 'application/msword'
        || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
        || request.resource.contentType == 'application/vnd.ms-powerpoint'
        || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.presentationml.presentation'
        || request.resource.contentType == 'application/vnd.ms-excel'
        || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet';
    }

    match /avatars/{userId}/{fileName} {
      allow read: if signedIn();
      allow create, update: if signedIn() && uid() == userId && under5mb() && isImage();
      allow delete: if signedIn() && uid() == userId;
    }

    match /users/{userId}/locker/{allPaths=**} {
      allow read: if signedIn() && uid() == userId;
      allow create, update: if signedIn() && uid() == userId && under50mb() && isEducationFile();
      allow delete: if signedIn() && uid() == userId;
    }

    match /users/{userId}/ai-uploads/{allPaths=**} {
      allow read: if signedIn() && uid() == userId;
      allow create, update: if signedIn() && uid() == userId && under50mb() && isEducationFile();
      allow delete: if signedIn() && uid() == userId;
    }

    match /schools/{schoolId}/assignments/{allPaths=**} {
      allow read: if signedIn() && sameSchool(schoolId);
      allow create, update: if signedIn() && sameSchool(schoolId) && isSchoolStaff() && under50mb() && isEducationFile();
      allow delete: if signedIn() && sameSchool(schoolId) && isSchoolStaff();
    }

    match /schools/{schoolId}/submissions/{studentId}/{allPaths=**} {
      allow read: if signedIn() && sameSchool(schoolId) && (uid() == studentId || isSchoolStaff());
      allow create, update: if signedIn() && sameSchool(schoolId) && uid() == studentId && under50mb() && isEducationFile();
      allow delete: if signedIn() && sameSchool(schoolId) && (uid() == studentId || isSchoolStaff());
    }

    match /schools/{schoolId}/lessons/{allPaths=**} {
      allow read: if signedIn() && sameSchool(schoolId);
      allow create, update: if signedIn() && sameSchool(schoolId) && isSchoolStaff() && under50mb() && isEducationFile();
      allow delete: if signedIn() && sameSchool(schoolId) && isSchoolStaff();
    }

    match /schools/{schoolId}/resources/{allPaths=**} {
      allow read: if signedIn() && sameSchool(schoolId);
      allow create, update: if signedIn() && sameSchool(schoolId) && isSchoolStaff() && under50mb() && isEducationFile();
      allow delete: if signedIn() && sameSchool(schoolId) && isSchoolStaff();
    }

    match /home/{userId}/{videoId}/{fileName} {
      allow read: if signedIn() && (uid() == userId || role() == 'superadmin');
      allow create, update: if signedIn() && uid() == userId && under80mb()
        && (
          request.resource.contentType.matches('video/.*')
          || request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'text/vtt'
          || request.resource.contentType == 'text/plain'
        );
      allow delete: if signedIn() && uid() == userId;
    }

    match /gold/{tutorId}/{allPaths=**} {
      allow read: if signedIn();
      allow create, update: if signedIn() && uid() == tutorId && under50mb() && isEducationFile();
      allow delete: if signedIn() && uid() == tutorId;
    }

    match /recordings/{schoolId}/{allPaths=**} {
      allow read: if signedIn() && sameSchool(schoolId);
      allow create, update: if signedIn() && sameSchool(schoolId) && isSchoolStaff()
        && under200mb()
        && request.resource.contentType.matches('video/.*');
      allow delete: if signedIn() && sameSchool(schoolId) && isSchoolStaff();
    }
  }
}
