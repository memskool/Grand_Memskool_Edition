{
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/*firebase-adminsdk*.json)",
      "Read(**/serviceAccount*.json)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git filter-branch*)",
      "Bash(git rebase -i*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(git commit*)",
      "Bash(npx firebase deploy*)",
      "Bash(firebase deploy*)"
    ],
    "allow": [
      "Bash(npm run typecheck*)",
      "Bash(npm run test*)",
      "Bash(npm run lint*)",
      "Bash(npx eslint --fix*)",
      "Bash(npx tsc --noEmit*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)"
    ]
  }
}
