# Memskool — environment variables
# Copy to `.env` for local work. On Lovable Cloud every server-side value below
# is stored as a backend secret, never in the client bundle.
# Only VITE_* values are exposed to the browser. Never prefix a secret with VITE_.

# ---------------------------------------------------------------- Supabase
# Auto-generated by Lovable Cloud — do not edit by hand.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------- Payments (Flutterwave)
FLUTTERWAVE_SECRET_KEY=            # FLWSECK-... server only
FLUTTERWAVE_WEBHOOK_HASH=          # "Secret hash" set in the Flutterwave dashboard;
                                   # the same value must be pasted there and here.
# Webhook URL to configure at Flutterwave:
#   https://<your-domain>/api/public/webhooks/flutterwave

# ---------------------------------------------------------------- Live classes (LiveKit)
LIVEKIT_URL=                       # wss://<project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---------------------------------------------------------------- Email (Resend)
RESEND_API_KEY=                    # re_... server only, never NEXT_PUBLIC_/VITE_
RESEND_FROM=Memskool <notifications@memskool.com>   # must use a domain verified in Resend

# ---------------------------------------------------------------- SMS (Africa's Talking)
AFRICASTALKING_USERNAME=           # "sandbox" for testing, else your AT username
AFRICASTALKING_API_KEY=            # server only
AFRICASTALKING_SENDER_ID=          # optional approved alphanumeric sender/short code

# ---------------------------------------------------------------- Notification worker
NOTIFICATIONS_DISPATCH_SECRET=     # shared secret for the delivery sweep endpoint
APP_ORIGIN=https://memskool.com    # used to build absolute links inside emails
# Schedule (every 1-5 minutes) a POST to:
#   https://<your-domain>/api/public/notifications/dispatch
#   header: x-dispatch-secret: <NOTIFICATIONS_DISPATCH_SECRET>
