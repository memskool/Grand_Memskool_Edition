# Memskool — environment variables
# Copy to `.env` for local work. Never commit `.env`.
# Only VITE_* values are exposed to the browser. Never prefix a secret with VITE_.
# Values filled below are public project identifiers already in your local `.env`.
# Leave blank keys blank here — put the real secrets only in `.env` and in Vercel.

# ---------------------------------------------------------------- Firebase (public client config — Memskool Web app)
VITE_FIREBASE_API_KEY=AIzaSyD3q6So-Pp13Ro9SCgGin8Eyc7JEZzkCi0
VITE_FIREBASE_AUTH_DOMAIN=memskool-4e193.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=memskool-4e193
VITE_FIREBASE_STORAGE_BUCKET=memskool-4e193.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=527812927420
VITE_FIREBASE_APP_ID=1:527812927420:web:01836b3f93d0a9fca855b9
VITE_FIREBASE_MEASUREMENT_ID=G-8BXYXGWC1R
# Optional. When set, App Check (reCAPTCHA v3) is initialized in the browser.
VITE_FIREBASE_APPCHECK_SITE_KEY=6LcSc5YtAAAAACEE-cUAvnsGqpbI-eFKsWP_1vBH
# Optional. Web Push certificate key from Firebase Console > Cloud Messaging.
VITE_FIREBASE_VAPID_KEY=BLSfCuztPA4JvOIQcX0ZNpTJU2WxRNwkOONwPy2RIBNFfMhAx34VHgBhQLnj1GPMQGoS7ZxkyL99NQd65c8yrOM
# Set true to talk to local emulators (auth 9099, firestore 8080, storage 9199).
VITE_USE_FIREBASE_EMULATORS=false

# ---------------------------------------------------------------- Firebase Admin (server functions / TanStack Start)
# Local: path to the downloaded service-account JSON (that file is gitignored).
# Vercel: paste the full JSON object as one line (not a file path).
FIREBASE_SERVICE_ACCOUNT_JSON=./memskool-4e193-firebase-adminsdk-fbsvc-1b10bcb559.json
GCLOUD_PROJECT=memskool-4e193
# Emulator hosts (set automatically by `firebase emulators:start`)
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# ---------------------------------------------------------------- Payments (Flutterwave)
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
# Webhook URL: https://<your-domain>/api/public/webhooks/flutterwave

# ---------------------------------------------------------------- Live classes (LiveKit)
LIVEKIT_URL=wss://memskool-0srvr5g8.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Webhook URL: https://<your-domain>/api/public/webhooks/livekit
# Configure the same API key/secret in the LiveKit Cloud (or self-hosted) webhook settings.

# ---------------------------------------------------------------- Email (Resend)
# Used for account confirmation, password reset, and school notices.
# Domain memskool.com must be verified in Resend. From address must match that domain.
# Keep the API key in `.env` / Vercel only — never in this file.
RESEND_API_KEY=
RESEND_FROM=Memskool <notifications@memskool.com>

# ---------------------------------------------------------------- SMS (Africa's Talking)
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=

# ---------------------------------------------------------------- Notification worker
NOTIFICATIONS_DISPATCH_SECRET=
APP_ORIGIN=https://memskool.com

# ---------------------------------------------------------------- Crane5 proprietary tutor (server only — never VITE_ prefix)
# HTTP adapter: OpenAI-compatible chat completions POST. Public crane5.com has no published API yet.
CRANE5_API_URL=
CRANE5_API_KEY=
CRANE5_MODEL=crane5-tutor
# Set true only when Crane5 accepts image parts.
CRANE5_VISION=false

# ---------------------------------------------------------------- Optional AI (dashboard learning-memory insights — not tutoring)
LOVABLE_API_KEY=
