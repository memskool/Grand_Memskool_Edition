rules_version = '2';

// ===============================================================
// Assumed Data Model (Phase 1)
// ===============================================================
// users/{uid}: full_name, email, avatar_url, phone, school_id, student_code,
//              role, membership_status, created_at, updated_at
// schools/{id}: name, code, owner_id, city, country, contact_email, website,
//               logo_url, admissions_open, created_at, updated_at
// school_directory/{CODE}: school_id, name, city, country  (public, non-sensitive)
// school_members/{id}: school_id, user_id, role, status, student_code, created_at
// Most academic collections include school_id and actor ids (owner_id, student_id, …)
// audit_logs/{id}: type, actor_id, school_id, target_id, summary, created_at
// Custom claims (Admin SDK only): role, schoolId, approved
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }
    function uid() {
      return request.auth.uid;
    }
    function tokenRole() {
      return request.auth.token.role;
    }
    function tokenSchool() {
      return request.auth.token.schoolId;
    }
    function isApproved() {
      return request.auth.token.approved == true
        || tokenRole() in ['student', 'parent', 'admin', 'superadmin'];
    }
    function isSuperAdmin() {
      return isAuthenticated() && tokenRole() == 'superadmin';
    }
    function profileRole() {
      return exists(/databases/$(database)/documents/users/$(uid()))
        ? get(/databases/$(database)/documents/users/$(uid())).data.role
        : null;
    }
    function isSchoolAdmin() {
      return isAuthenticated() && (
        tokenRole() in ['admin', 'institution', 'superadmin']
        || profileRole() in ['admin', 'institution', 'superadmin']
      );
    }
    function isTeacher() {
      return isAuthenticated() && tokenRole() == 'teacher' && isApproved();
    }
    function ownsSchoolDoc(schoolId) {
      return schoolId == uid()
        && exists(/databases/$(database)/documents/schools/$(schoolId))
        && get(/databases/$(database)/documents/schools/$(schoolId)).data.owner_id == uid();
    }
    function managesSchool(schoolId) {
      return isAuthenticated()
        && schoolId is string
        && schoolId.size() > 0
        && (
          schoolId == uid()
          || ownsSchoolDoc(schoolId)
          || (isSchoolAdmin() && sameSchool(schoolId))
        );
    }
    function sameSchool(schoolId) {
      return isAuthenticated()
        && schoolId is string
        && schoolId.size() > 0
        && (tokenSchool() == schoolId || ownsSchoolDoc(schoolId) || schoolId == uid());
    }
    function isOwner(userId) {
      return isAuthenticated() && uid() == userId;
    }
    // Deterministic id: parent_students/{parentUid}_{studentUid} (Admin or school-admin create).
    function isLinkedParent(studentId) {
      return isAuthenticated()
        && studentId is string
        && exists(/databases/$(database)/documents/parent_students/$(uid() + '_' + studentId));
    }
    function validRole(value) {
      return value in ['student', 'teacher', 'parent', 'admin', 'institution', 'superadmin'];
    }
    function stringMax(value, max) {
      return value is string && value.size() <= max;
    }
    function optionalString(value, max) {
      return value == null || stringMax(value, max);
    }
    function isValidUser(data) {
      return data.keys().hasAll(['full_name', 'email', 'role', 'created_at', 'updated_at'])
        && stringMax(data.full_name, 120)
        && optionalString(data.email, 320)
        && validRole(data.role)
        && optionalString(data.school_id, 128)
        && optionalString(data.student_code, 40)
        && optionalString(data.avatar_url, 2048)
        && optionalString(data.phone, 40);
    }

    match /school_directory/__index {
      allow read: if true;
      allow create: if isAuthenticated()
        && request.resource.data.school_ids is list
        && uid() in request.resource.data.school_ids
        && request.resource.data.school_ids.size() <= 1;
      allow update: if isAuthenticated()
        && request.resource.data.school_ids is list
        && uid() in request.resource.data.school_ids
        && (
          !('school_ids' in resource.data)
          || (
            request.resource.data.school_ids.hasAll(resource.data.school_ids)
            && request.resource.data.school_ids.size() <= resource.data.school_ids.size() + 1
          )
        );
      allow delete: if false;
    }
    match /school_directory/{code} {
      allow read: if true;
      // Owner bootstrap (when Admin SDK is unavailable): one directory row per uid.
      allow create: if isAuthenticated()
        && code != '__index'
        && request.resource.data.school_id == uid()
        && stringMax(request.resource.data.name, 160);
      allow update: if isAuthenticated()
        && resource.data.school_id == uid()
        && request.resource.data.school_id == uid();
      allow delete: if false;
    }

    match /user_directory/{email} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (
        isOwner(userId) || isSuperAdmin() || sameSchool(resource.data.school_id)
      );
      allow create: if isOwner(userId)
        && isValidUser(request.resource.data)
        && (
          (request.resource.data.role == 'student' && request.resource.data.school_id == null)
          || (request.resource.data.role in ['teacher', 'parent']
              && request.resource.data.school_id == null)
          || (request.resource.data.role in ['institution', 'admin']
              && (request.resource.data.school_id == null
                  || request.resource.data.school_id == userId))
        );
      allow update: if isValidUser(request.resource.data) && (
          (
            isOwner(userId)
            && request.resource.data.role == resource.data.role
            && request.resource.data.school_id == resource.data.school_id
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['full_name', 'phone', 'avatar_url', 'updated_at'])
          )
          || (
            isOwner(userId)
            && request.resource.data.role in ['institution', 'admin']
            && request.resource.data.school_id == userId
            && (resource.data.school_id == null || resource.data.school_id == userId)
          )
          || (
            managesSchool(request.resource.data.school_id)
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['school_id', 'membership_status', 'updated_at'])
            && (resource.data.school_id == null
                || resource.data.school_id == request.resource.data.school_id)
          )
        );
      allow delete: if false;
    }

    match /schools/{schoolId} {
      // Signed-in users can open a school by ID (Dream School details).
      // Listing the whole collection is platform-operator only — institutions
      // must not browse other schools from the client.
      allow get: if isAuthenticated();
      allow list: if isSuperAdmin();
      allow create: if isAuthenticated()
        && schoolId == uid()
        && request.resource.data.owner_id == uid()
        && stringMax(request.resource.data.name, 160);
      allow update: if request.resource.data.owner_id == resource.data.owner_id
        && (
          (isSchoolAdmin() && sameSchool(schoolId))
          || (resource.data.owner_id == uid() && schoolId == uid())
        )
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'city', 'country', 'contact_email', 'website', 'logo_url', 'admissions_open', 'code', 'updated_at', 'academic_period_label', 'current_academic_year_id', 'category', 'description', 'fees_min', 'fees_max', 'fees_currency', 'badges', 'is_international']);
      allow delete: if isSuperAdmin();
    }

    match /school_members/{id} {
      allow read: if isAuthenticated() && (
        isOwner(resource.data.user_id) || sameSchool(resource.data.school_id) || isSuperAdmin()
      );
      allow create: if isAuthenticated() && (
          (
            isOwner(request.resource.data.user_id)
            && request.resource.data.status == 'pending'
            && request.resource.data.role in ['student', 'teacher', 'parent']
            && request.resource.data.school_id is string
            && exists(/databases/$(database)/documents/schools/$(request.resource.data.school_id))
          )
          || (
            isOwner(request.resource.data.user_id)
            && request.resource.data.status == 'approved'
            && request.resource.data.role == 'institution'
            && request.resource.data.school_id == uid()
          )
          || (
            managesSchool(request.resource.data.school_id)
            && request.resource.data.role in ['student', 'teacher', 'parent']
            && request.resource.data.status in ['approved', 'rejected']
          )
        );
      allow update: if managesSchool(resource.data.school_id)
        && request.resource.data.school_id == resource.data.school_id
        && request.resource.data.user_id == resource.data.user_id
        && request.resource.data.status in ['pending', 'approved', 'rejected'];
      allow delete: if managesSchool(resource.data.school_id);
    }

    match /school_roster/{id} {
      allow read: if isSchoolAdmin() && sameSchool(resource.data.school_id);
      allow create: if isSchoolAdmin() && sameSchool(request.resource.data.school_id);
      allow update, delete: if isSchoolAdmin() && sameSchool(resource.data.school_id);
    }

    function tenantRead(schoolId) {
      return isAuthenticated() && (sameSchool(schoolId) || isSuperAdmin());
    }
    function tenantWrite(schoolId) {
      return isSchoolAdmin() && sameSchool(schoolId) || isTeacher() && sameSchool(schoolId);
    }
    function isLiveParticipant(sessionId) {
      return isAuthenticated()
        && sessionId is string
        && exists(/databases/$(database)/documents/classroom_participants/$(sessionId + '_' + uid()));
    }
    function conversationDoc(conversationId) {
      return get(/databases/$(database)/documents/conversations/$(conversationId));
    }
    function isConversationMember(conversationId) {
      return isAuthenticated()
        && conversationId is string
        && exists(/databases/$(database)/documents/conversations/$(conversationId))
        && (
          conversationDoc(conversationId).data.created_by == uid()
          || (
            conversationDoc(conversationId).data.member_ids is list
            && uid() in conversationDoc(conversationId).data.member_ids
          )
        );
    }

    match /classes/{id} {
      allow read: if tenantRead(resource.data.school_id);
      allow create: if tenantWrite(request.resource.data.school_id);
      allow update: if tenantWrite(resource.data.school_id);
      allow delete: if isSchoolAdmin() && sameSchool(resource.data.school_id);
    }
    match /subjects/{id} {
      allow read: if tenantRead(resource.data.school_id);
      allow create: if isSchoolAdmin() && sameSchool(request.resource.data.school_id);
      allow update: if isSchoolAdmin() && sameSchool(resource.data.school_id);
      allow delete: if isSchoolAdmin() && sameSchool(resource.data.school_id)
        && resource.data.status == 'archived';
    }
    match /class_enrollments/{id} {
      allow read: if isAuthenticated() && (
        isOwner(resource.data.student_id) || tenantRead(resource.data.school_id)
      );
      allow create: if isSchoolAdmin() && sameSchool(request.resource.data.school_id);
      allow update: if isSchoolAdmin() && sameSchool(resource.data.school_id)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'ended_at']);
      allow delete: if false;
    }
    match /class_teacher_assignments/{id} {
      allow read: if isAuthenticated() && (
        isOwner(resource.data.teacher_id) || tenantRead(resource.data.school_id)
      );
      allow create: if isSchoolAdmin() && sameSchool(request.resource.data.school_id);
      allow update: if isSchoolAdmin() && sameSchool(resource.data.school_id)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'ended_at']);
      allow delete: if false;
    }
    match /academic_years/{id} {
      allow read: if tenantRead(resource.data.school_id);
      allow create, update: if isSchoolAdmin() && sameSchool(request.resource.data.school_id);
      allow delete: if false;
    }
    match /academic_periods/{id} {
      allow read: if tenantRead(resource.data.school_id);
      allow create, update: if isSchoolAdmin() && sameSchool(request.resource.data.school_id);
      allow delete: if false;
    }
    match /curricula/{id} {
      allow read: if tenantRead(resource.data.school_id);
      allow create: if isSchoolAdmin() && sameSchool(request.resource.data.school_id);
      allow update, delete: if isSchoolAdmin() && sameSchool(resource.data.school_id);
    }
    match /curriculum_levels/{id} {
      allow read: if tenantRead(resource.data.school_id);
      allow create: if isSchoolAdmin() && sameSchool(request.resource.data.school_id);
      allow update, delete: if isSchoolAdmin() && sameSchool(resource.data.school_id);
    }
    match /curriculum_topics/{id} {
      allow read: if tenantRead(resource.data.school_id);
      allow create: if isSchoolAdmin() && sameSchool(request.resource.data.school_id);
      allow update, delete: if isSchoolAdmin() && sameSchool(resource.data.school_id);
    }
    match /curriculum_objectives/{id} {
      allow read: if tenantRead(resource.data.school_id);
      allow create: if isSchoolAdmin() && sameSchool(request.resource.data.school_id);
      allow update, delete: if isSchoolAdmin() && sameSchool(resource.data.school_id);
    }
    match /lessons/{id} {
      allow read: if tenantRead(resource.data.school_id);
      allow create: if tenantWrite(request.resource.data.school_id);
      allow update: if tenantWrite(resource.data.school_id) && (
        isSchoolAdmin()
        || (isOwner(resource.data.teacher_id) && resource.data.status != 'completed')
      );
      allow delete: if isSchoolAdmin() && sameSchool(resource.data.school_id);
    }
    match /lesson_materials/{id} {
      allow read: if tenantRead(resource.data.school_id);
      allow create: if tenantWrite(request.resource.data.school_id);
      allow update, delete: if tenantWrite(resource.data.school_id);
    }
    match /timetable_slots/{id} {
      allow read: if tenantRead(resource.data.school_id);
      allow create: if tenantWrite(request.resource.data.school_id);
      allow update, delete: if tenantWrite(resource.data.school_id);
    }
    match /attendance/{id} {
      allow read: if isAuthenticated() && (
        isOwner(resource.data.student_id)
        || tenantWrite(resource.data.school_id)
        || isLinkedParent(resource.data.student_id)
      );
      allow create, update: if tenantWrite(request.resource.data.school_id);
      allow delete: if isSchoolAdmin() && sameSchool(resource.data.school_id);
    }
    match /assignments/{id} {
      allow read: if tenantRead(resource.data.school_id);
      allow create: if tenantWrite(request.resource.data.school_id);
      allow update: if tenantWrite(resource.data.school_id);
      allow delete: if tenantWrite(resource.data.school_id) && resource.data.status == 'draft';
    }
    match /submissions/{id} {
      allow read: if isAuthenticated() && (
        isOwner(resource.data.student_id)
        || tenantWrite(resource.data.school_id)
        || isLinkedParent(resource.data.student_id)
      );
      allow create: if isOwner(request.resource.data.student_id)
        && sameSchool(request.resource.data.school_id);
      allow update: if tenantWrite(resource.data.school_id)
        || (
          isOwner(resource.data.student_id)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['text_body', 'storage_paths', 'status', 'updated_at', 'late', 'submitted_at'])
          && request.resource.data.status in ['submitted', 'late']
        );
      allow delete: if isSchoolAdmin() && sameSchool(resource.data.school_id);
    }
    match /assessments/{id} {
      allow read: if tenantWrite(resource.data.school_id)
        || (
          tenantRead(resource.data.school_id)
          && resource.data.published == true
          && resource.data.status != 'draft'
        );
      allow create, update, delete: if false;
    }
    match /assessment_questions/{id} {
      allow read: if tenantWrite(resource.data.school_id)
        || (
          tenantRead(resource.data.school_id)
          && exists(/databases/$(database)/documents/assessments/$(resource.data.assessment_id))
          && get(/databases/$(database)/documents/assessments/$(resource.data.assessment_id)).data.published == true
        );
      allow create, update, delete: if false;
    }
    match /assessment_answer_keys/{id} {
      allow read, write: if false;
    }
    match /assessment_submissions/{id} {
      allow read: if isAuthenticated() && (
        isOwner(resource.data.student_id)
        || tenantWrite(resource.data.school_id)
        || (
          isLinkedParent(resource.data.student_id)
          && resource.data.results_released != false
        )
      );
      allow create, update, delete: if false;
    }
    match /question_bank/{id} {
      allow read: if tenantWrite(resource.data.school_id);
      allow write: if false;
    }
    match /performance_summaries/{id} {
      allow read: if isOwner(id)
        || isOwner(resource.data.student_id)
        || tenantWrite(resource.data.school_id)
        || isLinkedParent(resource.data.student_id);
      allow write: if false;
    }
    match /revision_plans/{id} {
      allow read: if isOwner(resource.data.student_id) || tenantWrite(resource.data.school_id);
      allow write: if false;
    }
    match /assessment_integrity_events/{id} {
      allow read: if tenantWrite(resource.data.school_id);
      allow write: if false;
    }
    match /assessment_result_private/{id} {
      allow read: if tenantWrite(resource.data.school_id);
      allow write: if false;
    }
    match /locker_folders/{id} {
      allow read, update, delete: if isOwner(resource.data.owner_id);
      allow create: if isOwner(request.resource.data.owner_id)
        && request.resource.data.owner_id == uid();
    }
    match /locker_items/{id} {
      allow read: if isOwner(resource.data.owner_id)
        || (resource.data.visibility == 'school' && tenantRead(resource.data.school_id));
      allow create: if isOwner(request.resource.data.owner_id)
        && request.resource.data.keys().hasAll(['owner_id', 'title', 'created_at'])
        && stringMax(request.resource.data.title, 200)
        && request.resource.data.owner_id == uid();
      allow update: if isOwner(resource.data.owner_id)
        && request.resource.data.owner_id == resource.data.owner_id
        && request.resource.data.school_id == resource.data.school_id
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['title', 'visibility', 'folder_id', 'updated_at', 'storage_path']);
      allow delete: if isOwner(resource.data.owner_id);
    }
    match /library_books/{id} {
      allow read: if tenantRead(resource.data.school_id);
      allow create: if tenantWrite(request.resource.data.school_id);
      allow update, delete: if tenantWrite(resource.data.school_id);
    }
    match /missed_work/{id} {
      allow read: if isAuthenticated() && (
        isOwner(resource.data.student_id) || tenantRead(resource.data.school_id)
      );
      allow create, update: if tenantWrite(request.resource.data.school_id);
      allow delete: if isSchoolAdmin() && sameSchool(resource.data.school_id);
    }
    match /classroom_sessions/{id} {
      allow read: if tenantRead(resource.data.school_id)
        || (isAuthenticated() && resource.data.kind == 'gold');
      allow create, update, delete: if false;
    }
    match /classroom_participants/{id} {
      allow read: if tenantRead(resource.data.school_id) && (
        isTeacher() || isSchoolAdmin() || isOwner(resource.data.user_id)
        || isLiveParticipant(resource.data.session_id)
      );
      allow create, delete: if false;
      allow update: if isOwner(resource.data.user_id)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['hand_raised', 'mic_on', 'cam_on']);
    }
    match /classroom_messages/{id} {
      allow read: if tenantRead(resource.data.school_id) && (
        isTeacher() || isSchoolAdmin() || isLiveParticipant(resource.data.session_id)
      );
      allow create, update, delete: if false;
    }
    match /live_session_events/{id} {
      allow read, write: if false;
    }
    match /conversations/{id} {
      allow read: if isConversationMember(id);
      allow create: if isAuthenticated()
        && isOwner(request.resource.data.created_by)
        && request.resource.data.member_ids is list
        && uid() in request.resource.data.member_ids
        && request.resource.data.member_ids.size() <= 20;
      allow update: if isConversationMember(id)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['updated_at', 'title']);
      allow delete: if false;
    }
    match /conversation_members/{id} {
      allow read: if isOwner(resource.data.user_id)
        || isConversationMember(resource.data.conversation_id);
      allow create: if isAuthenticated()
        && request.resource.data.conversation_id is string
        && exists(/databases/$(database)/documents/conversations/$(request.resource.data.conversation_id))
        && conversationDoc(request.resource.data.conversation_id).data.created_by == uid();
      allow delete: if isOwner(resource.data.user_id);
    }
    match /messages/{id} {
      allow read: if isConversationMember(resource.data.conversation_id);
      allow create: if isOwner(request.resource.data.sender_id)
        && stringMax(request.resource.data.body, 8000)
        && isConversationMember(request.resource.data.conversation_id);
      allow update, delete: if isOwner(resource.data.sender_id)
        && isConversationMember(resource.data.conversation_id);
    }
    match /notifications/{id} {
      allow read: if isOwner(resource.data.user_id);
      allow create: if isAuthenticated()
        && request.resource.data.user_id is string
        && stringMax(request.resource.data.title, 160)
        && (
          isOwner(request.resource.data.user_id)
          || ownsSchoolDoc(request.resource.data.school_id)
          || (isSchoolAdmin() && sameSchool(request.resource.data.school_id))
        );
      allow update: if isOwner(resource.data.user_id)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isOwner(resource.data.user_id);
    }
    match /notification_preferences/{id} {
      allow read, update: if isOwner(resource.data.user_id) || isOwner(id);
      allow create: if isOwner(id) || isOwner(request.resource.data.user_id);
      allow delete: if false;
    }
    match /notification_deliveries/{id} {
      allow read, write: if false;
    }
    match /fcm_tokens/{id} {
      allow read, delete: if isOwner(resource.data.user_id);
      allow create, update: if isOwner(request.resource.data.user_id)
        && stringMax(request.resource.data.token, 4096);
    }
    match /parent_students/{id} {
      allow read: if isAuthenticated() && (
        isOwner(resource.data.parent_id) || isOwner(resource.data.student_id)
        || (isSchoolAdmin() && sameSchool(resource.data.school_id))
      );
      allow create: if isSchoolAdmin()
        && sameSchool(request.resource.data.school_id)
        && request.resource.data.parent_id is string
        && request.resource.data.student_id is string
        && request.resource.data.parent_id != request.resource.data.student_id
        && id == request.resource.data.parent_id + '_' + request.resource.data.student_id;
      allow delete: if isSchoolAdmin() && sameSchool(resource.data.school_id);
      allow update: if false;
    }
    match /user_relations/{id} {
      allow read: if isAuthenticated() && (
        isOwner(resource.data.user_id) || isOwner(resource.data.target_id)
      );
      allow create: if isOwner(request.resource.data.user_id);
      allow delete: if isOwner(resource.data.user_id);
    }
    match /disciplinary_actions/{id} {
      allow read: if isAuthenticated() && (
        isOwner(resource.data.student_id) || tenantWrite(resource.data.school_id)
      );
      allow create, update: if tenantWrite(request.resource.data.school_id);
      allow delete: if isSchoolAdmin() && sameSchool(resource.data.school_id);
    }
    match /reward_events/{id} {
      allow read: if isAuthenticated() && (
        isOwner(resource.data.student_id) || tenantRead(resource.data.school_id)
      );
      allow create, update, delete: if false;
    }
    match /marketplace_items/{id} {
      allow read: if tenantRead(resource.data.school_id);
      allow create: if tenantWrite(request.resource.data.school_id);
      allow update, delete: if tenantWrite(resource.data.school_id);
    }
    match /orders/{id} {
      allow read: if isOwner(resource.data.buyer_id) || isSuperAdmin();
      allow create, update, delete: if false;
    }
    match /school_applications/{id} {
      allow read: if isOwner(resource.data.student_id) || isOwner(resource.data.user_id)
        || isLinkedParent(resource.data.student_id)
        || managesSchool(resource.data.school_id);
      allow create: if isOwner(request.resource.data.student_id) || isOwner(request.resource.data.user_id);
      allow delete: if isOwner(resource.data.student_id) || isOwner(resource.data.user_id)
        || (isSchoolAdmin() && sameSchool(resource.data.school_id))
        || ownsSchoolDoc(resource.data.school_id);
      allow update: if managesSchool(resource.data.school_id)
        && request.resource.data.school_id == resource.data.school_id
        && request.resource.data.student_id == resource.data.student_id
        && request.resource.data.status in ['pending', 'under_review', 'approved', 'rejected'];
    }
    match /school_meetings/{id} {
      allow read: if tenantRead(resource.data.school_id);
      allow create: if tenantWrite(request.resource.data.school_id);
      allow update, delete: if tenantWrite(resource.data.school_id);
    }
    match /study_reminders/{id} {
      allow read, update, delete: if isOwner(resource.data.user_id);
      allow create: if isOwner(request.resource.data.user_id);
    }
    match /ai_insights/{id} {
      allow read, update: if isOwner(resource.data.user_id);
      allow create: if false;
      allow delete: if isOwner(resource.data.user_id);
    }
    match /ai_conversations/{id} {
      allow read, update, delete: if isOwner(resource.data.owner_id);
      allow create: if false;
    }
    match /ai_messages/{id} {
      allow read: if isOwner(resource.data.owner_id);
      allow create, update: if false;
      allow delete: if isOwner(resource.data.owner_id);
    }
    match /ai_learning_memory/{id} {
      allow read, delete: if isOwner(resource.data.owner_id);
      allow create, update: if false;
    }
    match /ai_usage/{id} {
      allow read: if isOwner(resource.data.owner_id);
      allow write: if false;
    }
    match /ai_rate_limits/{id} {
      allow read, write: if false;
    }
    match /learning_profiles/{id} {
      allow read, update: if isOwner(id) || isOwner(resource.data.student_id) || isOwner(resource.data.user_id);
      allow create: if isOwner(id) || isOwner(request.resource.data.student_id) || isOwner(request.resource.data.user_id);
      allow delete: if false;
    }
    match /payment_events/{id} {
      allow read, write: if false;
    }
    match /gold_tutors/{tutorId} {
      allow get: if isAuthenticated();
      allow list: if isSuperAdmin();
      allow create, update, delete: if false;
    }
    match /gold_classes/{id} {
      allow get: if isAuthenticated();
      allow list: if isSuperAdmin();
      allow create, update, delete: if false;
    }
    match /gold_enrolments/{id} {
      allow get: if isAuthenticated() && (
        isOwner(resource.data.learner_id) || isOwner(resource.data.tutor_id) || isSuperAdmin()
      );
      allow list: if isSuperAdmin();
      allow create, update, delete: if false;
    }
    match /gold_lessons/{id} {
      allow get: if isAuthenticated();
      allow list: if isSuperAdmin();
      allow create, update, delete: if false;
    }
    match /gold_resources/{id} {
      allow get: if isAuthenticated();
      allow list: if isSuperAdmin();
      allow create, update, delete: if false;
    }
    match /gold_reviews/{id} {
      allow get: if isAuthenticated();
      allow list: if isSuperAdmin();
      allow create, update, delete: if false;
    }
    match /home_videos/{id} {
      allow get: if resource.data.status == 'published'
        || (isAuthenticated() && (isOwner(resource.data.creator_id) || isSuperAdmin()));
      allow list: if isSuperAdmin();
      allow create, update, delete: if false;
    }
    match /home_likes/{id} {
      allow read, write: if false;
    }
    match /home_saves/{id} {
      allow read, write: if false;
    }
    match /home_views/{id} {
      allow read, write: if false;
    }
    match /home_reports/{id} {
      allow read: if isSuperAdmin();
      allow create, update, delete: if false;
    }
    match /home_interests/{userId} {
      allow read: if isOwner(userId) || isSuperAdmin();
      allow write: if false;
    }
    match /home_rate_limits/{id} {
      allow read, write: if false;
    }
    match /signup_requests/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update, delete: if false;
    }
    match /audit_logs/{id} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
